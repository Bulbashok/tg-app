# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_TEACHER_ID=123456789          # your numeric Telegram user id
BOT_USERNAME=english_exercise_bot      # without leading @

# ---- Groq (AI vision) ----
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.2-11b-vision-preview
# Local dev only, if Groq blocks your region (on Render leave empty):
# HTTPS_PROXY=http://127.0.0.1:1080

# ---- Supabase (backend uses the SERVICE-ROLE key) ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # server only! never ship to client
SUPABASE_IMAGE_BUCKET=textbook-images

# ---- Web App / glue ----
WEB_APP_URL=https://your-app.vercel.app

# ---- Server ----
PORT=3000
