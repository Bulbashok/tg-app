# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_TEACHER_ID=123456789          # your numeric Telegram user id
# Multiple teachers allowed: comma-separate the ids
# TELEGRAM_TEACHER_ID=123456789,987654321
BOT_USERNAME=english_exercise_bot      # without leading @

# ---- AI vision (OpenAI-compatible; default = Groq) ----
# Groq's current vision model (Llama vision models were removed):
AI_API_KEY=gsk_xxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b
# Groq FREE tier: <=1000 output tokens/min -> cap sits at that limit. Raise
# after upgrading to Dev/Prod tier, or when switching to OpenRouter:
AI_MAX_OUTPUT_TOKENS=1000
# Alternative provider (e.g. if Groq geo-blocks your local dev IP):
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_API_KEY=sk-or-v1-xxxxxxxx
#   AI_MODEL=qwen/qwen3.8-27b
# Local dev only, if the provider blocks your region (on Render leave empty):
# HTTPS_PROXY=http://127.0.0.1:1080

# ---- Supabase (backend uses the SERVICE-ROLE key) ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # server only! never ship to client
SUPABASE_IMAGE_BUCKET=textbook-images

# ---- Web App / glue ----
WEB_APP_URL=https://your-app.vercel.app
# After registering the Mini App in @BotFather (/newapp), put its short link
# here, e.g. https://t.me/eng_task_master_bot/english
# -> exercises become shareable/forwardable as plain t.me links that open with
#    proper authorization, so student scores save from any chat. Leave empty
#    until /newapp is done (then the bot explains how in each publish).
TME_APP_URL=

# ---- Server ----
PORT=3000
